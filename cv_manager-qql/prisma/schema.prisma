// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(uuid())
  name  String
  email String  @unique
  role  Role    @default(USER)
  cvs   Cv[]
}

model Skill {
  id          String     @id @default(uuid())
  designation String
  cvs         CvSkill[]
}

model Cv {
  id       String     @id @default(uuid())
  name     String
  age      Int
  job      String
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  skills   CvSkill[]
}

model CvSkill {
  cv      Cv     @relation(fields: [cvId], references: [id])
  cvId    String
  skill   Skill  @relation(fields: [skillId], references: [id])
  skillId String

  @@id([cvId, skillId])
}

enum Role {
  USER
  ADMIN
}